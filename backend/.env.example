PACELAB_ENV=development
PACELAB_SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
PACELAB_DATABASE_URL=sqlite:///./pacelab-dev.db
PACELAB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: path to a trusted artifact you trained yourself.
# PACELAB_MODEL_PATH=models/race_rf.joblib

# Optional grounded language-model assistant. Never commit real API keys.
# PACELAB_ASSISTANT_PROVIDER=openai
# OPENAI_API_KEY=replace-with-your-own-key
# PACELAB_ASSISTANT_MODEL=choose-an-available-model-for-your-API-account

# Managed DB URL may start with postgresql://; driver is normalized to psycopg 3.
# PACELAB_DATABASE_URL=postgresql://...
