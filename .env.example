# Copy to .env and generate independent random secrets before starting Compose.
# Do not commit real secrets. For local-only development.
POSTGRES_PASSWORD=replace-with-a-long-random-password
PACELAB_SECRET_KEY=replace-with-a-different-random-secret-at-least-32-characters

# Optional private-beta model and external assistant; keep actual keys out of git.
# PACELAB_MODEL_PATH=/app/models/race_rf.joblib
# PACELAB_ASSISTANT_PROVIDER=openai
# PACELAB_ASSISTANT_MODEL=YOUR_RESPONSES_API_MODEL
# OPENAI_API_KEY=YOUR_SECRET_API_KEY
# PACELAB_DOMAIN=your-domain.example
